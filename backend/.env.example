# ⚠️ NUNCA subas este archivo a git con valores reales.
# Este es solo un template. Copia a .env y completa tus valores.
#
# INSTRUCCIONES DE SEGURIDAD:
# 1. NUNCA commitear .env con valores reales.
# 2. Rotar credenciales inmediatamente si se exponen.
# 3. Usar variables de entorno del sistema en producción.
#
# ── Servidor ─────────────────────────────────────────────────────
PORT=3001
SUPERADMIN_EMAIL=admin@example.com
APPROVER_ROLES=supervisor,admin
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=256kb
ENABLE_API_DOCS=true
ENABLE_METRICS_WEBSOCKET=false
ALLOW_DEV_TOKENS=false
TICKET_SUBMIT_RATE_WINDOW_MS=60000
TICKET_SUBMIT_RATE_MAX=20
PRIVILEGED_RATE_WINDOW_MS=60000
PRIVILEGED_RATE_MAX=60
INVENTORY_READ_RATE_WINDOW_MS=60000
INVENTORY_READ_RATE_MAX=120

# Observabilidad y alertas (el panel guarda una ventana acotada en memoria y emite JSON a stdout)
MONITORING_LOG_CAPACITY=2000
MONITORING_ERROR_RATE_WARN=0.05
MONITORING_ERROR_RATE_CRITICAL=0.20
MONITORING_LATENCY_WARN_MS=1000
MONITORING_LATENCY_CRITICAL_MS=3000
ALERT_LATENCY_MS=2000
ALERT_DEDUP_WINDOW_MS=300000
ALERT_TICKET_FAILURE_WINDOW_MS=300000
ALERT_TICKET_FAILURE_THRESHOLD=3
ALERT_4XX_WINDOW_MS=300000
ALERT_4XX_THRESHOLD=20
INTEGRITY_CHECK_INTERVAL_MS=300000
TICKET_MAX_ITEMS=100
STOCK_LOCK_TTL_MS=120000
TICKET_REVIEW_STALE_MS=86400000

# ── API de Inventario (externa) ───────────────────────────────────
INVENTORY_API_BASE_URL=http://localhost:5000/api
INVENTORY_HTTP_TIMEOUT_MS=15000
INVENTORY_SERVICE_UID=inventory-service
INVENTORY_AUTH_API_KEY=
INVENTORY_STATIC_BEARER_TOKEN=

# ── Firebase Admin SDK (inventario - default) ────────────────────
# Usa service-account.json (descargado de Firebase Console) o estas variables:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Firebase Admin SDK (tickets - base de datos propia) ──────────
# Opcional: Si no se configura, se usa la DB por defecto.
# Opcion 1: Colocar ticket-service-account.json en backend/
# Opcion 2: Usar estas variables:
# TICKET_FIREBASE_PROJECT_ID=ticketdatabase-97de0
# TICKET_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ticketdatabase-97de0.iam.gserviceaccount.com
# TICKET_FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=tickets@cielitohome.com
